# Скопируйте этот файл в .env и впишите свой ключ. Файл .env в git не попадает.

# Провайдер: gemini (по умолчанию), ollama (локальная модель, документ не покидает компьютер)
# или openai (любой OpenAI-совместимый API)
LLM_PROVIDER=gemini

# Google Gemini — бесплатный ключ: https://aistudio.google.com/ → Get API key
GEMINI_API_KEY=your_gemini_api_key_here
# Основная модель и резервные (агент переключается при перегрузке 503, 404 или исчерпании квоты).
# Список доступных вашему ключу: python -m revizor --list-models
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash
# Необязательно: глубина рассуждений для моделей Gemini 3 (minimal | low | medium | high)
# GEMINI_THINKING_LEVEL=low

# Локальные модели (Ollama): ollama pull qwen3:4b
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen3:4b
# OLLAMA_NUM_CTX=24576   # окно контекста: промпты агентов занимают до ~20 тыс. токенов

# OpenAI-совместимый API (OpenAI, OpenRouter, LM Studio, vLLM)
# OPENAI_API_KEY=your_key
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Ограничения прогона
LLM_RPM=5            # запросов в минуту (бесплатный тариф Gemini — 5)
LLM_MAX_CALLS=12     # бюджет новых вызовов LLM на один прогон (обычно хватает 8)
# LLM_TEMPERATURE=   # по умолчанию — значение модели
