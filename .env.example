# Скопируйте этот файл в .env и впишите свой ключ. Файл .env в git не попадает.

# Провайдер: gemini (по умолчанию) или openai (любой OpenAI-совместимый API, включая Ollama)
LLM_PROVIDER=gemini

# Google Gemini — бесплатный ключ: https://aistudio.google.com/ → Get API key
GEMINI_API_KEY=your_gemini_api_key_here
# Псевдоним всегда указывает на актуальную Flash-модель. Список доступных: python -m revizor --list-models
GEMINI_MODEL=gemini-flash-latest
# Необязательно: глубина рассуждений для моделей Gemini 3 (minimal | low | medium | high)
# GEMINI_THINKING_LEVEL=low

# OpenAI-совместимый API (OpenAI, OpenRouter, LM Studio, vLLM, Ollama)
# OPENAI_API_KEY=your_key
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=http://localhost:11434/v1   # для Ollama

# Ограничения прогона
LLM_RPM=5            # запросов в минуту (бесплатный тариф Gemini — 5)
LLM_MAX_CALLS=12     # бюджет новых вызовов LLM на один прогон (обычно хватает 8)
# LLM_TEMPERATURE=   # по умолчанию — значение модели
